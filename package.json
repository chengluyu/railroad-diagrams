{
  "name": "railroad-diagrams",
  "version": "1.1.0",
  "description": "A small JS+SVG library for drawing railroad syntax diagrams.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node dist/test/run-tests.js",
    "test:all": "npm run test && npm run test:options && npm run test:edge",
    "test:snapshots": "node dist/test/run-tests.js --generate-snapshots",
    "test:visual": "node dist/test/visual-css-classes-test.js",
    "test:options": "node dist/test/options-combination-test.js",
    "test:edge": "node dist/test/edge-case-test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tabatkins/railroad-diagrams.git"
  },
  "keywords": [
    "railroad",
    "syntax",
    "diagrams",
    "grammar",
    "svg"
  ],
  "author": "Tab Atkins Jr.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tabatkins/railroad-diagrams/issues"
  },
  "homepage": "https://github.com/tabatkins/railroad-diagrams"
}
